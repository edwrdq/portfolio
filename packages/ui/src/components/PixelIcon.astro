---
import { cells, type IconName } from "../icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, class: cls, label } = Astro.props;
const on = cells(name);
---

<svg
  class:list={["pixel-icon", cls]}
  width={size}
  height={size}
  viewBox="0 0 8 8"
  shape-rendering="crispEdges"
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {on.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
</svg>

<style>
  .pixel-icon {
    flex: none;
    image-rendering: pixelated;
  }
</style>
