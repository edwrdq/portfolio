{
  "name": "rooms",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=\"$HOME/.config/cloudflare/dev-registry/v5\" wrangler dev --env dev --port 8787 --persist-to ../admin/.wrangler/state",
    "deploy": "wrangler deploy --env=\"\"",
    "types": "wrangler types",
    "migrate:local": "CLOUDFLARE_ENV=dev wrangler d1 migrations apply edwrdq-db --local --persist-to ../admin/.wrangler/state"
  },
  "dependencies": {
    "@edwrdq/rooms": "workspace:*",
    "wrangler": "^4.166.0"
  }
}
