---
import { env } from "cloudflare:workers";
import { ALGOS, WIDTHS } from "@edwrdq/dither";

const { results } = await env.DB.prepare("SELECT id, name, params, is_default FROM dither_presets ORDER BY name").all<{ id: number; name: string; params: string; is_default: number }>();
const data = JSON.stringify(results).replace(/</g, "\\u003c");
const mediaReady = !!(env as unknown as { MEDIA?: unknown }).MEDIA;
const ALGO_LABEL: Record<string, string> = { atkinson: "atkinson", floyd: "floyd–steinberg", bayer4: "bayer 4×4", bayer8: "bayer 8×8", threshold: "threshold" };
---

<div class="dt" data-dt data-media={mediaReady ? "1" : ""}>
  <label class="zone" data-zone>
    <input type="file" accept="image/*" class="sr-only" data-file />
    <span class="zone-big">drop a photo</span>
    <span class="zone-small">or tap to pick · processed in your browser, the original never leaves it</span>
  </label>

  <div class="ws" data-ws hidden>
    <div class="stagebar">
      <button type="button" class="btn sm" data-hold>HOLD: ORIGINAL</button>
      <button type="button" class="btn sm" data-zoom aria-pressed="false">100%</button>
      <button type="button" class="btn sm" data-crop aria-pressed="false">CROP</button>
      <span class="info" data-info></span>
    </div>
    <div class="chips aspects" data-aspects hidden>
      {["free", "1:1", "4:5", "16:9", "3:2"].map((a, i) => <button type="button" class="chip" data-aspect={a} aria-pressed={String(i === 0)}>{a}</button>)}
      <button type="button" class="chip" data-crop-reset>full</button>
    </div>

    <div class="stage" data-stage>
      <canvas class="out" data-out></canvas>
      <canvas class="orig" data-orig hidden></canvas>
      <div class="cropview" data-cropview hidden>
        <canvas data-srcview></canvas>
        <div class="rect" data-rect><span class="handle" data-handle></span></div>
      </div>
    </div>

    <div class="controls">
      <div class="ctl">
        <p class="label">ALGORITHM</p>
        <div class="chips">{ALGOS.map((a) => <button type="button" class="chip" data-p="algo" data-v={a}>{ALGO_LABEL[a]}</button>)}</div>
      </div>
      <div class="ctl">
        <p class="label">WIDTH</p>
        <div class="chips">{WIDTHS.map((w) => <button type="button" class="chip" data-p="width" data-v={w}>{w}</button>)}</div>
      </div>
      <div class="ctl two">
        <div>
          <p class="label">DOT SCALE</p>
          <div class="chips">{[1, 2, 3].map((s) => <button type="button" class="chip" data-p="scale" data-v={s}>{s}×</button>)}</div>
        </div>
        <div>
          <p class="label">PALETTE</p>
          <div class="chips">
            <button type="button" class="chip" data-p="palette" data-v="bone">bone</button>
            <button type="button" class="chip" data-p="palette" data-v="acid">acid</button>
            <button type="button" class="chip" data-p="palette" data-v="invert">black on bone</button>
          </div>
        </div>
      </div>
      <div class="sliders">
        <label><span>BRIGHTNESS <b data-val="brightness"></b></span><input type="range" min="-100" max="100" step="1" data-r="brightness" /></label>
        <label><span>CONTRAST <b data-val="contrast"></b></span><input type="range" min="-100" max="100" step="1" data-r="contrast" /></label>
        <label><span>GAMMA <b data-val="gamma"></b></span><input type="range" min="0.2" max="3" step="0.05" data-r="gamma" /></label>
        <label data-thr><span>THRESHOLD <b data-val="threshold"></b></span><input type="range" min="0" max="255" step="1" data-r="threshold" /></label>
        <label class="check"><input type="checkbox" data-norm /> normalise (stretch contrast first — like the script)</label>
      </div>
      <div class="row">
        <button type="button" class="btn sm" data-reset>RESET TO SCRIPT</button>
      </div>
    </div>

    <section class="block">
      <p class="label">PRESETS</p>
      <div class="chips" data-presets></div>
      <div class="row">
        <input class="field grow" placeholder="preset name" maxlength="40" autocapitalize="none" spellcheck="false" data-pname />
        <button type="button" class="btn sm" data-psave>SAVE PRESET</button>
      </div>
    </section>

    <section class="block">
      <p class="label">EXPORT</p>
      <div class="row">
        <button type="button" class="btn sm" data-download>DOWNLOAD PNG</button>
      </div>
      <div class="pub">
        <input class="field" placeholder="file name" maxlength="40" autocapitalize="none" spellcheck="false" data-iname />
        <input class="field" placeholder="alt text — what's in the picture" maxlength="300" data-alt />
        <button type="button" class="btn btn-primary" data-publish>PUBLISH</button>
      </div>
      <p class="status" data-status aria-live="polite"></p>
      <div class="result" data-result hidden>
        <code data-res-url></code>
        <button type="button" class="btn sm" data-copy="url">COPY URL</button>
        <code data-res-md></code>
        <button type="button" class="btn sm" data-copy="md">COPY MARKDOWN</button>
      </div>
    </section>
  </div>

  <section class="block">
    <p class="label">PUBLISHED</p>
    <ul class="pubs" data-pubs></ul>
  </section>

  <script type="application/json" data-json set:html={data} />
</div>

<style>
  .dt {
    max-width: 60rem;
  }
  .zone {
    display: grid;
    place-items: center;
    gap: 0.4rem;
    min-height: 8rem;
    padding: 1.25rem;
    border: 1px solid var(--seam);
    background: var(--surface);
    text-align: center;
    cursor: pointer;
  }
  .zone:hover,
  .zone.over,
  .zone:focus-within {
    border-color: var(--acid);
  }
  .zone-big {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: var(--track-tight);
    color: var(--bone);
  }
  .zone-small {
    font-size: var(--fs-small);
    color: var(--dim-2);
  }
  .ws {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .stagebar,
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .info {
    margin-left: auto;
    font-size: var(--fs-small);
    color: var(--dim-2);
    font-variant-numeric: tabular-nums;
  }
  .btn.sm {
    height: 2.75rem;
    padding-inline: 0.85rem;
  }
  .btn[aria-pressed="true"] {
    border-color: var(--acid);
    color: var(--acid);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips :global(.chip) {
    min-height: 2.5rem;
  }
  .stage {
    position: relative;
    border: 1px solid var(--seam);
    background: var(--bg);
    max-height: 75vh;
    overflow: auto;
    touch-action: pan-x pan-y;
  }
  .stage canvas {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  .stage.zoomed canvas.out,
  .stage.zoomed canvas.orig {
    width: auto;
    max-width: none;
  }
  .cropview {
    position: relative;
    user-select: none;
    touch-action: none;
  }
  .cropview canvas {
    image-rendering: auto;
  }
  .rect {
    position: absolute;
    border: 1px solid var(--acid);
    box-shadow: 0 0 0 9999px color-mix(in srgb, var(--bg) 65%, transparent);
    cursor: move;
  }
  .handle {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--acid);
    cursor: nwse-resize;
  }
  .controls {
    display: grid;
    gap: 1rem;
  }
  .ctl .label {
    margin-bottom: 0.5rem;
  }
  .two {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .sliders {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem 1.5rem;
  }
  .sliders label {
    display: grid;
    gap: 0.35rem;
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--dim-2);
  }
  .sliders b {
    color: var(--text);
    font-weight: 400;
  }
  .sliders label.off {
    opacity: 0.35;
  }
  input[type="range"] {
    appearance: auto;
    accent-color: var(--acid);
    width: 100%;
    min-height: 2rem;
  }
  .check {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: 0.02em !important;
    font-size: var(--fs-small) !important;
    color: var(--dim-1) !important;
  }
  .check input {
    appearance: auto;
    accent-color: var(--acid);
    width: 1rem;
    height: 1rem;
  }
  .block {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .grow {
    flex: 1;
    min-width: 10rem;
  }
  .pub {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 0.5rem;
  }
  .pub .btn {
    height: auto;
  }
  .status {
    font-size: var(--fs-small);
    color: var(--text);
    min-height: 1.2em;
  }
  .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--seam);
  }
  .result code {
    font-size: var(--fs-small);
    color: var(--bone);
    overflow-wrap: anywhere;
  }
  .presets-def {
    color: var(--acid);
  }
  .pubs {
    display: grid;
    gap: 0.5rem;
  }
  .pubs:empty::before {
    content: attr(data-empty);
    color: var(--dim-3);
    font-size: var(--fs-small);
  }
  .pubs :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid var(--seam-soft);
  }
  .pubs :global(img) {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .pubs :global(.meta) {
    flex: 1;
    min-width: 10rem;
    display: grid;
    gap: 0.2rem;
    font-size: var(--fs-small);
  }
  .pubs :global(.meta span:last-child) {
    color: var(--dim-2);
  }
  .pubs :global(button) {
    height: 2.5rem;
    padding-inline: 0.7rem;
    border: 1px solid var(--seam);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--dim-1);
  }
  @media (max-width: 640px) {
    .pub {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { DEFAULTS, clean, ditherWidth, hexToRgb, run, type Params } from "@edwrdq/dither";

  type Preset = { id: number; name: string; params: string; is_default: number };
  type Crop = { x: number; y: number; w: number; h: number }; // source px

  const root = document.querySelector<HTMLElement>("[data-dt]");
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    let presets: Preset[] = JSON.parse($("[data-json]").textContent || "[]");
    const def = presets.find((p) => p.is_default);
    let params: Params = clean(def ? JSON.parse(def.params) : DEFAULTS);
    const css = getComputedStyle(document.documentElement);
    const colors = { bone: hexToRgb(css.getPropertyValue("--bone")), acid: hexToRgb(css.getPropertyValue("--acid")), bg: hexToRgb(css.getPropertyValue("--bg")) };
    const status = $("[data-status]");

    let src: ImageBitmap | null = null;
    let crop: Crop = { x: 0, y: 0, w: 1, h: 1 };
    let aspect: number | null = null; // w/h, null = free
    let fileBase = "img";
    let cache: { key: string; data: Uint8ClampedArray; w: number; h: number } | null = null;

    // ---------------- ui sync
    function syncUI() {
      for (const b of $$<HTMLButtonElement>("[data-p]")) b.setAttribute("aria-pressed", String(String((params as any)[b.dataset.p!]) === b.dataset.v));
      for (const r of $$<HTMLInputElement>("[data-r]")) {
        r.value = String((params as any)[r.dataset.r!]);
        $(`[data-val="${r.dataset.r}"]`).textContent = r.dataset.r === "gamma" ? Number(r.value).toFixed(2) : r.value;
      }
      $<HTMLInputElement>("[data-norm]").checked = params.normalize;
      $("[data-thr]").classList.toggle("off", params.algo !== "threshold");
      $<HTMLInputElement>('[data-r="threshold"]').disabled = params.algo !== "threshold";
    }
    const set = (patch: Partial<Params>) => {
      params = clean({ ...params, ...patch });
      syncUI();
      schedule();
    };

    // ---------------- processing
    async function resized(dw: number, dh: number) {
      const key = `${crop.x},${crop.y},${crop.w},${crop.h}->${dw}x${dh}`;
      if (cache?.key === key) return cache;
      let bmp: ImageBitmap;
      try {
        bmp = await createImageBitmap(src!, crop.x, crop.y, crop.w, crop.h, { resizeWidth: dw, resizeHeight: dh, resizeQuality: "high" });
      } catch {
        // fallback: halve step by step, then a final draw (keeps quality on big downscales)
        let c = document.createElement("canvas");
        c.width = crop.w;
        c.height = crop.h;
        c.getContext("2d")!.drawImage(src!, crop.x, crop.y, crop.w, crop.h, 0, 0, crop.w, crop.h);
        while (c.width / 2 > dw) {
          const n = document.createElement("canvas");
          n.width = Math.round(c.width / 2);
          n.height = Math.round(c.height / 2);
          const x = n.getContext("2d")!;
          x.imageSmoothingQuality = "high";
          x.drawImage(c, 0, 0, n.width, n.height);
          c = n;
        }
        bmp = await createImageBitmap(c, { resizeWidth: dw, resizeHeight: dh, resizeQuality: "high" }).catch(() => createImageBitmap(c));
      }
      const c = document.createElement("canvas");
      c.width = dw;
      c.height = dh;
      const ctx = c.getContext("2d", { willReadFrequently: true })!;
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(bmp, 0, 0, dw, dh);
      bmp.close();
      cache = { key, data: ctx.getImageData(0, 0, dw, dh).data, w: dw, h: dh };
      return cache;
    }

    let pending = false;
    const schedule = () => {
      if (pending || !src) return;
      pending = true;
      requestAnimationFrame(async () => {
        pending = false;
        await process();
      });
    };
    async function process() {
      if (!src) return;
      const dw = ditherWidth(params, crop.w);
      const dh = Math.max(1, Math.round((crop.h * dw) / crop.w));
      const px = await resized(dw, dh);
      const t0 = performance.now();
      const out = run(px.data, px.w, px.h, 4, params, colors, 4);
      const c = $<HTMLCanvasElement>("[data-out]");
      c.width = out.width;
      c.height = out.height;
      c.getContext("2d")!.putImageData(new ImageData(out.data, out.width, out.height), 0, 0);
      $("[data-info]").textContent = `${out.width}×${out.height} · ${Math.round(performance.now() - t0)}ms`;
    }

    // ---------------- loading
    async function load(file: File) {
      if (!file.type.startsWith("image/")) return void (status.textContent = "that's not an image.");
      try {
        src?.close();
        src = await createImageBitmap(file, { imageOrientation: "from-image" } as ImageBitmapOptions);
      } catch {
        return void (status.textContent = "couldn't read that image (heic? try a jpg/png export).");
      }
      fileBase = file.name.replace(/\.[^.]+$/, "").toLowerCase().replace(/[^a-z0-9_-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40) || "img";
      $<HTMLInputElement>("[data-iname]").value = fileBase;
      crop = { x: 0, y: 0, w: src.width, h: src.height };
      aspect = null;
      $$("[data-aspect]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.aspect === "free")));
      cache = null;
      $("[data-ws]").hidden = false;
      $("[data-result]").hidden = true;
      status.textContent = "";
      setCropMode(false);
      syncUI();
      await process();
    }
    const zone = $("[data-zone]");
    $<HTMLInputElement>("[data-file]").addEventListener("change", (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (f) load(f);
      (e.target as HTMLInputElement).value = "";
    });
    for (const ev of ["dragenter", "dragover"]) zone.addEventListener(ev, (e) => (e.preventDefault(), zone.classList.add("over")));
    for (const ev of ["dragleave", "drop"]) zone.addEventListener(ev, () => zone.classList.remove("over"));
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) load(f);
    });
    window.addEventListener("dragover", (e) => e.preventDefault());
    window.addEventListener("drop", (e) => e.preventDefault());

    // ---------------- controls
    root.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-p]");
      if (!b) return;
      const k = b.dataset.p as keyof Params;
      const v = b.dataset.v!;
      set({ [k]: k === "width" || k === "scale" ? Number(v) : v } as Partial<Params>);
    });
    for (const r of $$<HTMLInputElement>("[data-r]")) r.addEventListener("input", () => set({ [r.dataset.r!]: Number(r.value) }));
    $<HTMLInputElement>("[data-norm]").addEventListener("change", (e) => set({ normalize: (e.target as HTMLInputElement).checked }));
    $("[data-reset]").addEventListener("click", () => set({ ...DEFAULTS }));

    // before/after: hold to see the original (cropped, same size, full colour)
    const hold = $("[data-hold]");
    const showOrig = (on: boolean) => {
      const o = $<HTMLCanvasElement>("[data-orig]");
      const out = $<HTMLCanvasElement>("[data-out]");
      if (on && src) {
        o.width = out.width;
        o.height = out.height;
        const ctx = o.getContext("2d")!;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(src, crop.x, crop.y, crop.w, crop.h, 0, 0, o.width, o.height);
      }
      o.hidden = !on;
      out.hidden = on;
    };
    hold.addEventListener("pointerdown", (e) => (e.preventDefault(), showOrig(true)));
    for (const ev of ["pointerup", "pointerleave", "pointercancel"]) hold.addEventListener(ev, () => showOrig(false));
    hold.addEventListener("keydown", (e) => e.key === " " && showOrig(true));
    hold.addEventListener("keyup", (e) => e.key === " " && showOrig(false));

    $("[data-zoom]").addEventListener("click", (e) => {
      const on = $("[data-stage]").classList.toggle("zoomed");
      (e.currentTarget as HTMLElement).setAttribute("aria-pressed", String(on));
    });

    // ---------------- crop
    const view = $("[data-cropview]");
    const rectEl = $("[data-rect]");
    const srcView = $<HTMLCanvasElement>("[data-srcview]");
    function setCropMode(on: boolean) {
      view.hidden = !on;
      $<HTMLCanvasElement>("[data-out]").hidden = on;
      $("[data-aspects]").hidden = !on;
      $("[data-crop]").setAttribute("aria-pressed", String(on));
      $("[data-crop]").textContent = on ? "DONE" : "CROP";
      if (on && src) {
        const scale = Math.min(1, 1400 / src.width);
        srcView.width = Math.round(src.width * scale);
        srcView.height = Math.round(src.height * scale);
        srcView.getContext("2d")!.drawImage(src, 0, 0, srcView.width, srcView.height);
        drawRect();
      }
      if (!on) {
        cache = null;
        schedule();
      }
    }
    const drawRect = () => {
      if (!src) return;
      rectEl.style.left = `${(crop.x / src.width) * 100}%`;
      rectEl.style.top = `${(crop.y / src.height) * 100}%`;
      rectEl.style.width = `${(crop.w / src.width) * 100}%`;
      rectEl.style.height = `${(crop.h / src.height) * 100}%`;
    };
    const fitAspect = (a: number | null) => {
      if (!src) return;
      if (a === null) return;
      let w = src.width;
      let h = Math.round(w / a);
      if (h > src.height) (h = src.height), (w = Math.round(h * a));
      crop = { x: Math.round((src.width - w) / 2), y: Math.round((src.height - h) / 2), w, h };
    };
    $("[data-crop]").addEventListener("click", () => setCropMode(view.hidden));
    root.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-aspect]");
      if (a) {
        const [x, y] = a.dataset.aspect!.split(":").map(Number);
        aspect = a.dataset.aspect === "free" ? null : x / y;
        $$("[data-aspect]").forEach((b) => b.setAttribute("aria-pressed", String(b === a)));
        fitAspect(aspect);
        drawRect();
      }
      if ((e.target as HTMLElement).closest("[data-crop-reset]") && src) {
        aspect = null;
        $$("[data-aspect]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.aspect === "free")));
        crop = { x: 0, y: 0, w: src.width, h: src.height };
        drawRect();
      }
    });
    let drag: { mode: "move" | "size"; sx: number; sy: number; start: Crop; k: number } | null = null;
    view.addEventListener("pointerdown", (e) => {
      if (!src) return;
      const target = e.target as HTMLElement;
      if (!target.closest("[data-rect]")) return;
      e.preventDefault();
      view.setPointerCapture(e.pointerId);
      const k = src.width / view.getBoundingClientRect().width; // screen px → source px
      drag = { mode: target.closest("[data-handle]") ? "size" : "move", sx: e.clientX, sy: e.clientY, start: { ...crop }, k };
    });
    view.addEventListener("pointermove", (e) => {
      if (!drag || !src) return;
      const dx = (e.clientX - drag.sx) * drag.k;
      const dy = (e.clientY - drag.sy) * drag.k;
      const s = drag.start;
      const min = Math.max(16, Math.round(src.width * 0.04));
      if (drag.mode === "move") {
        crop = { ...s, x: Math.round(Math.min(Math.max(0, s.x + dx), src.width - s.w)), y: Math.round(Math.min(Math.max(0, s.y + dy), src.height - s.h)) };
      } else {
        let w = Math.min(Math.max(min, s.w + dx), src.width - s.x);
        let h = aspect ? w / aspect : Math.min(Math.max(min, s.h + dy), src.height - s.y);
        if (aspect && s.y + h > src.height) (h = src.height - s.y), (w = h * aspect);
        crop = { ...s, w: Math.round(w), h: Math.round(h) };
      }
      drawRect();
    });
    const endDrag = () => (drag = null);
    view.addEventListener("pointerup", endDrag);
    view.addEventListener("pointercancel", endDrag);

    // ---------------- presets
    async function api(path: string, payload?: Record<string, unknown>) {
      const res = await fetch(`/api/dither/${path}`, payload ? { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) } : undefined);
      const out = (await res.json().catch(() => ({}))) as any;
      if (!res.ok || !out.ok) throw Object.assign(new Error(out.error ?? `failed (${res.status})`), { exists: out.exists });
      return out;
    }
    function renderPresets() {
      const box = $("[data-presets]");
      box.replaceChildren(
        ...presets.map((p) => {
          const wrap = document.createElement("span");
          wrap.className = "chips";
          const load = Object.assign(document.createElement("button"), { type: "button", className: "chip", textContent: p.is_default ? `★ ${p.name}` : p.name });
          load.addEventListener("click", () => set(JSON.parse(p.params)));
          const star = Object.assign(document.createElement("button"), { type: "button", className: "chip", textContent: p.is_default ? "unset default" : "make default" });
          star.addEventListener("click", async () => {
            try {
              await api("default", { id: p.is_default ? null : p.id });
              presets = presets.map((x) => ({ ...x, is_default: !p.is_default && x.id === p.id ? 1 : 0 }));
              renderPresets();
            } catch (e) {
              status.textContent = (e as Error).message;
            }
          });
          const del = Object.assign(document.createElement("button"), { type: "button", className: "chip", textContent: "×" });
          del.setAttribute("aria-label", `delete preset ${p.name}`);
          del.addEventListener("click", async () => {
            if (!confirm(`delete preset ${p.name}?`)) return;
            try {
              await api("delete-preset", { id: p.id });
              presets = presets.filter((x) => x.id !== p.id);
              renderPresets();
            } catch (e) {
              status.textContent = (e as Error).message;
            }
          });
          wrap.append(load, star, del);
          return wrap;
        }),
      );
    }
    $("[data-psave]").addEventListener("click", async () => {
      const name = $<HTMLInputElement>("[data-pname]").value.trim().toLowerCase();
      const go = async (overwrite: boolean) => {
        const { preset } = await api("preset", { name, params, overwrite });
        presets = [...presets.filter((x) => x.name !== preset.name), preset].sort((a, b) => a.name.localeCompare(b.name));
        renderPresets();
        status.textContent = `saved preset ${preset.name}.`;
      };
      try {
        await go(false);
      } catch (e: any) {
        if (e.exists && confirm(`${name} exists. overwrite?`)) await go(true).catch((x) => (status.textContent = x.message));
        else status.textContent = e.message;
      }
    });

    // ---------------- export + publish (only the processed png ever leaves the browser)
    const pngBlob = () => new Promise<Blob>((res, rej) => $<HTMLCanvasElement>("[data-out]").toBlob((b) => (b ? res(b) : rej(new Error("export failed"))), "image/png"));
    $("[data-download]").addEventListener("click", async () => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(await pngBlob());
      a.download = `${$<HTMLInputElement>("[data-iname]").value.trim() || fileBase}.png`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    $("[data-publish]").addEventListener("click", async () => {
      const alt = $<HTMLInputElement>("[data-alt]").value.trim();
      if (!alt) {
        status.textContent = "add alt text first — say what's in the picture.";
        $<HTMLInputElement>("[data-alt]").focus();
        return;
      }
      status.textContent = "publishing…";
      try {
        const name = $<HTMLInputElement>("[data-iname]").value.trim() || fileBase;
        const res = await fetch(`/api/dither/publish?name=${encodeURIComponent(name)}&alt=${encodeURIComponent(alt)}`, {
          method: "POST",
          headers: { "content-type": "image/png" },
          body: await pngBlob(),
        });
        const out = (await res.json().catch(() => ({}))) as any;
        if (!res.ok || !out.ok) throw new Error(out.error ?? `failed (${res.status})`);
        $("[data-res-url]").textContent = out.url;
        $("[data-res-md]").textContent = out.markdown;
        $("[data-result]").hidden = false;
        status.textContent = "published.";
        loadPublished();
      } catch (e) {
        status.textContent = (e as Error).message;
      }
    });
    root.addEventListener("click", async (e) => {
      const c = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
      if (!c) return;
      await navigator.clipboard?.writeText($(c.dataset.copy === "url" ? "[data-res-url]" : "[data-res-md]").textContent ?? "");
      const was = c.textContent;
      c.textContent = "COPIED";
      setTimeout(() => (c.textContent = was), 900);
    });

    // ---------------- published list
    async function loadPublished() {
      const box = $("[data-pubs]");
      try {
        const { ready, items } = await api("published");
        box.dataset.empty = ready ? "nothing published yet." : "publishing needs the edwrdq-media bucket — see the admin notes.";
        box.replaceChildren(
          ...items.map((it: { key: string; url: string; size: number; alt: string }) => {
            const li = document.createElement("li");
            const img = Object.assign(document.createElement("img"), { src: it.url, alt: it.alt, loading: "lazy" });
            const meta = document.createElement("div");
            meta.className = "meta";
            meta.append(Object.assign(document.createElement("span"), { textContent: it.key.replace(/^img\//, "") }), Object.assign(document.createElement("span"), { textContent: it.alt || "no alt" }));
            const md = Object.assign(document.createElement("button"), { type: "button", textContent: "COPY MD" });
            md.addEventListener("click", () => navigator.clipboard?.writeText(`![${it.alt.replace(/[[\]]/g, "")}](${it.url})`));
            const del = Object.assign(document.createElement("button"), { type: "button", textContent: "DELETE" });
            del.addEventListener("click", async () => {
              if (!confirm("delete this image? anything linking to it will break.")) return;
              try {
                await api("unpublish", { key: it.key });
                li.remove();
              } catch (x) {
                status.textContent = (x as Error).message;
              }
            });
            li.append(img, meta, md, del);
            return li;
          }),
        );
      } catch {
        box.dataset.empty = "couldn't load published images.";
      }
    }

    syncUI();
    renderPresets();
    loadPublished();
  }
</script>
