---
import "@edwrdq/ui/fonts.css";
import "@edwrdq/ui/tokens.css";
import "@edwrdq/ui/base.css";
import "../styles/prose.css";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** og card name in public/og (generated by scripts/og.mjs), e.g. "music" or "blog/hello" */
  og?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "eddy quintero. engineer, founder. builds things that move, compute, trade, and sound good.",
  og = "index",
  type = "website",
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} — edwrdq` : "edwrdq";
// canonical without a trailing slash, matching the sitemap and how pages are linked
const url = new URL(Astro.url.pathname.replace(/(.)\/+$/, "$1"), Astro.site);
const image = new URL(`/og/${og}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060606" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="edwrdq — blog" href="/rss.xml" />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content="edwrdq" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? "edward quintero"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <TopBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
