---
// work + experience: a plain timeline, newest first
import type { CollectionEntry } from "astro:content";
import { stampMonth } from "../lib/content";

interface Props {
  entries: CollectionEntry<"projects">[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
  {
    entries.map((e) => (
      <li class="item">
        <span class="when">
          {stampMonth(e.data.date)}
          <span class="dash">—</span>
          {e.data.end ? stampMonth(e.data.end) : "now"}
        </span>
        <div class="what">
          <h2 class="display title">{e.data.title}</h2>
          <p class="summary">{e.data.summary}</p>
          {e.data.links && (
            <p class="links">
              {e.data.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    border-bottom: 1px solid var(--seam-soft);
  }
  .item {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.5rem 1.75rem;
    border-top: 1px solid var(--seam-soft);
  }
  .item:nth-child(even) {
    margin-left: var(--shift);
  }
  .when {
    font-size: var(--fs-small);
    color: var(--dim-2);
    font-variant-numeric: tabular-nums;
  }
  .dash {
    color: var(--dim-4);
    margin-inline: 0.5ch;
  }
  .title {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--track-tight);
    text-transform: lowercase;
  }
  .summary {
    margin-top: 0.6rem;
    color: var(--dim-1);
    max-width: 52ch;
  }
  .links {
    margin-top: 0.75rem;
    display: flex;
    gap: 1.25rem;
    font-size: var(--fs-small);
  }
  .links a {
    border-bottom: 1px solid var(--dim-4);
  }
  .links a:hover {
    color: var(--bone);
    border-color: var(--bone);
  }
  @media (min-width: 960px) {
    .item {
      grid-template-columns: var(--offset) minmax(0, 1fr);
      align-items: baseline;
      gap: 0;
    }
    .item:nth-child(even) {
      /* the row is --shift narrower, so % resolves smaller — compensate to hit the page offset */
      grid-template-columns: calc(var(--offset) - (1 - var(--offset-k)) * var(--shift)) minmax(0, 1fr);
    }
  }
</style>
