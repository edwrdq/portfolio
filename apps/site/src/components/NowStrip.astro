---
// "currently" strip. filled client-side from /api/now and refreshed every 30s.
// all text goes in via textContent. album art is redrawn as a 12×12 pixel grid, never shown raw.
import PixelIcon from "@edwrdq/ui/PixelIcon.astro";
---

<div class="now" data-now hidden>
  <p class="l1">
    <span class="dot" data-dot aria-hidden="true"></span>
    <span class="txt" data-txt></span>
    <span class="ago" data-ago></span>
    <a class="more" href="/stats">this week →</a>
  </p>
  <p class="l2 cs" data-custom hidden>
    <span class="emo" data-emo></span>
    <span class="det" data-cs></span>
  </p>
  <p class="l2" data-act hidden>
    <canvas class="art" data-act-art width="12" height="12" hidden aria-hidden="true"></canvas>
    <span class="det" data-det></span>
  </p>
  <p class="l2" data-music hidden>
    <canvas class="art" data-art width="12" height="12" hidden aria-hidden="true"></canvas>
    <span class="note" aria-hidden="true"><PixelIcon name="note" size={12} /></span>
    <a class="trk" data-trk target="_blank" rel="noopener"></a>
  </p>
</div>

<style>
  .now {
    display: grid;
    gap: 0.45rem;
    font-size: var(--fs-small);
    min-width: 0;
  }
  .l1,
  .l2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    white-space: nowrap;
  }
  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--acid);
  }
  .now.is-live .dot {
    animation: pulse 1.8s var(--ease) infinite;
  }
  /* discord state. no state (lanyard off) keeps the acid default */
  .now[data-presence="idle"] .dot {
    background: #c49a3a;
  }
  .now[data-presence="dnd"] .dot {
    background: #c4503a;
  }
  .now[data-presence="offline"] .dot {
    background: var(--dim-3);
  }
  .cs .det {
    font-style: italic;
  }
  .emo {
    flex: none;
  }
  .emo:empty {
    display: none;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .txt,
  .det,
  .trk {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .txt {
    color: var(--text);
  }
  .now:not(.is-live) .txt {
    color: var(--dim-2);
  }
  .ago {
    flex: none;
    color: var(--dim-3);
  }
  .ago:empty {
    display: none;
  }
  .more {
    flex: none;
    margin-left: auto;
    color: var(--dim-2);
  }
  .more:hover {
    color: var(--bone);
  }
  .l2 {
    color: var(--dim-2);
  }
  .note {
    flex: none;
    display: inline-flex;
    color: var(--dim-2);
  }
  .art {
    flex: none;
    width: 24px;
    height: 24px;
    image-rendering: pixelated;
  }
  .art:not([hidden]) + .note {
    display: none;
  }
  .trk {
    color: var(--dim-1);
  }
  .det:empty {
    display: none;
  }
  a.trk[href]:hover {
    color: var(--bone);
  }
  @media (prefers-reduced-motion: reduce) {
    .now.is-live .dot {
      animation: none;
    }
  }
</style>

<script>
  type Now = {
    status: {
      text: string;
      tag: string | null;
      source: string;
      live: boolean;
      since: string | null;
      detail?: string | null;
      start?: string | null;
      art?: string | null;
    } | null;
    presence?: "online" | "idle" | "dnd" | "offline" | null;
    custom?: { text: string | null; emoji: string | null } | null;
    music: { track: string; artist: string | null; url: string | null; art: string | null } | null;
  };

  const root = document.querySelector<HTMLElement>("[data-now]");
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const txt = $("[data-txt]");
    const ago = $("[data-ago]");
    const musicRow = $("[data-music]");
    const trk = $<HTMLAnchorElement>("[data-trk]");
    const canvas = $<HTMLCanvasElement>("[data-art]");
    const actRow = $("[data-act]");
    const det = $("[data-det]");
    const actCanvas = $<HTMLCanvasElement>("[data-act-art]");
    const csRow = $("[data-custom]");
    const csText = $("[data-cs]");
    const emo = $("[data-emo]");
    const lastArt = new WeakMap<HTMLCanvasElement, string | null>();

    // show art on a canvas (only redraws when the url changes)
    const setArt = (cv: HTMLCanvasElement, src: string | null | undefined) => {
      if (!src) {
        lastArt.set(cv, null);
        cv.hidden = true;
        return;
      }
      if (lastArt.get(cv) === src) return;
      lastArt.set(cv, src);
      pixelate(cv, src).then(() => (cv.hidden = false)).catch(() => (cv.hidden = true));
    };

    const elapsed = (iso: string) => {
      const m = Math.floor(Math.max(0, Date.now() - Date.parse(iso)) / 60_000);
      if (m < 1) return "just started";
      if (m < 60) return `${m}m`;
      return `${Math.floor(m / 60)}h ${m % 60}m`;
    };

    const rel = (iso: string) => {
      const s = Math.max(0, (Date.now() - Date.parse(iso)) / 1000);
      if (s < 60) return "just now";
      if (s < 3600) return `${Math.round(s / 60)}m ago`;
      if (s < 86400) return `${Math.round(s / 3600)}h ago`;
      return `${Math.round(s / 86400)}d ago`;
    };

    // pixelate: average the cover down to a 12×12 grid of real colors; css scales it to 24px with hard edges
    const pixelate = (canvas: HTMLCanvasElement, src: string) =>
      new Promise<void>((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
          // halve in steps so every grid cell is a true average, not a few sampled pixels
          let cur: CanvasImageSource = img;
          let w = img.naturalWidth;
          let h = img.naturalHeight;
          while (w > canvas.width * 2 || h > canvas.height * 2) {
            w = Math.max(canvas.width, Math.ceil(w / 2));
            h = Math.max(canvas.height, Math.ceil(h / 2));
            const step = document.createElement("canvas");
            step.width = w;
            step.height = h;
            const sctx = step.getContext("2d")!;
            sctx.imageSmoothingQuality = "high";
            sctx.drawImage(cur, 0, 0, w, h);
            cur = step;
          }
          const ctx = canvas.getContext("2d")!;
          ctx.imageSmoothingQuality = "high";
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(cur, 0, 0, canvas.width, canvas.height);
          resolve();
        };
        img.onerror = () => reject(new Error("art"));
        img.src = src; // same-origin (/api/now/art), so the canvas stays readable
      });

    const render = (n: Now) => {
      const s = n.status;
      if (!s && !n.music) {
        root.hidden = true;
        return;
      }
      root.hidden = false;
      root.classList.toggle("is-live", !!s?.live || !!n.music);
      if (n.presence) root.dataset.presence = n.presence;
      else delete root.dataset.presence;
      const dotLabel = n.presence === "dnd" ? "do not disturb" : n.presence ?? "";
      $("[data-dot]").title = dotLabel;

      const c = n.custom;
      csRow.hidden = !c;
      emo.textContent = c?.emoji ?? "";
      csText.textContent = c?.text ? `“${c.text}”` : "";

      if (s) {
        const tagged = s.tag && s.source === "manual" && !s.text.toLowerCase().startsWith(s.tag) ? `${s.tag} — ${s.text}` : s.text;
        txt.textContent = tagged;
        ago.textContent = !s.live && s.since ? rel(s.since) : s.live && s.start ? elapsed(s.start) : "";
      } else {
        txt.textContent = "listening";
        ago.textContent = "";
      }

      const showAct = !!s && (!!s.detail || !!s.art);
      actRow.hidden = !showAct;
      det.textContent = (showAct && s?.detail) || "";
      setArt(actCanvas, showAct ? s?.art : null);

      const m = n.music;
      musicRow.hidden = !m;
      if (m) {
        trk.textContent = m.artist ? `${m.track} — ${m.artist}` : m.track;
        if (m.url && /^https?:\/\//.test(m.url)) trk.href = m.url;
        else trk.removeAttribute("href");
        setArt(canvas, m.art);
      }
    };

    const load = async () => {
      try {
        const res = await fetch("/api/now", { headers: { accept: "application/json" } });
        if (res.ok) render(await res.json());
      } catch {
        /* keep whatever is showing */
      }
    };

    load();
    let timer = setInterval(load, 30_000);
    document.addEventListener("visibilitychange", () => {
      clearInterval(timer);
      if (!document.hidden) {
        load();
        timer = setInterval(load, 30_000);
      }
    });
  }
</script>
