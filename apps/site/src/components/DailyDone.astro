---
// the "done" panel every daily shares: result, share button + preview, stats, solve rate, countdown.
// filled by showDone() from lib/daily-done.ts.
---

<div class="done" data-done hidden>
  <p class="label" data-done-label>SOLVED</p>
  <div class="reveal" data-reveal></div>
  <p class="score" data-score></p>
  <div class="row">
    <button type="button" class="btn btn-primary" data-share>SHARE</button>
    <span class="shared" data-shared aria-live="polite"></span>
  </div>
  <pre class="share-preview" data-share-preview></pre>
  <dl class="stats" data-stats></dl>
  <p class="next" data-next></p>
</div>

<style>
  .done {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--seam);
  }
  .reveal {
    display: grid;
    gap: 0.6rem;
    color: var(--text);
  }
  .reveal :global(.big) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: var(--track-tight);
    color: var(--bone);
  }
  .reveal :global(p) {
    max-width: 62ch;
  }
  .reveal :global(.dim) {
    color: var(--dim-1);
  }
  .reveal :global(a) {
    color: var(--bone);
    border-bottom: 1px solid var(--dim-3);
  }
  .score {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .shared {
    font-size: var(--fs-small);
    color: var(--dim-1);
  }
  .share-preview {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--dim-1);
    white-space: pre-wrap;
    padding: 0.75rem;
    border: 1px solid var(--seam-soft);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
    grid-auto-flow: dense;
  }
  .stats :global(dt) {
    grid-row: 2;
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--dim-2);
  }
  .stats :global(dd) {
    grid-row: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--bone);
  }
  .next {
    font-size: var(--fs-small);
    color: var(--dim-2);
    font-variant-numeric: tabular-nums;
  }
</style>
