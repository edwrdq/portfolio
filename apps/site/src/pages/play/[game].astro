---
// /play/<game>: what it is, quick play, make a room, join with a code. static html; the buttons need js.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ToolFoot from "../../components/ToolFoot.astro";
import Faq from "../../components/Faq.astro";
import { GAMES, gameInfo, type GameId } from "@edwrdq/rooms";
import { PLAY } from "../../lib/play";
import { playLd } from "../../lib/ld";

export const getStaticPaths = () => GAMES.map((g) => ({ params: { game: g.id } }));
const game = Astro.params.game as GameId;
const g = gameInfo(game);
const c = PLAY[game];
const n = `P${String(GAMES.indexOf(g) + 1).padStart(2, "0")}`;
---

<Base title={c.title} description={c.description} og={`play/${game}`} noindex={!g.ready}>
  <script type="application/ld+json" slot="head" set:html={playLd({ path: g.href, name: g.name, description: c.description, faq: c.faq, og: `play/${game}`, min: 1, max: g.max, genre: c.genre })} />
  <PageHead n={n} label={`PLAY — ${g.name.toUpperCase()}`} title={g.name} intro={c.intro} />

  <section class="start gutter" data-start data-game={game} aria-label="start playing">
    {!g.ready && <p class="soon">the rooms and chat are open. the game itself lands soon, so for now a room is a lobby.</p>}
    <div class="go">
      <button type="button" class="btn btn-primary" data-quick disabled>QUICK PLAY</button>
      <button type="button" class="btn" data-new disabled>MAKE A ROOM</button>
    </div>
    <form class="join" data-join>
      <label class="label" for="join-code">join with a code</label>
      <div class="join-row">
        <input id="join-code" class="field code" data-code maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="K7QX" />
        <button type="submit" class="btn" disabled>JOIN</button>
      </div>
    </form>
    <p class="msg" data-msg aria-live="polite"></p>
    <noscript><p class="msg">multiplayer needs javascript. everything below works without it.</p></noscript>
  </section>

  <section class="explain gutter" aria-label="how it works">
    <h2 class="h">how to play</h2>
    <ol class="steps">{c.how.map((s) => <li>{s}</li>)}</ol>
    <Faq items={c.faq} />
  </section>

  <ToolFoot />
</Base>

<script>
  import { getCode } from "@edwrdq/rooms/client";
  import { isCode } from "@edwrdq/rooms";

  const root = document.querySelector<HTMLElement>("[data-start]");
  if (root) {
    const game = root.dataset.game!;
    const msg = root.querySelector<HTMLElement>("[data-msg]")!;
    const buttons = root.querySelectorAll<HTMLButtonElement>("button");
    buttons.forEach((b) => (b.disabled = false));
    const go = (code: string) => location.assign(`/play/${game}/${code}`);
    async function ask(kind: "new" | "quick") {
      buttons.forEach((b) => (b.disabled = true));
      msg.textContent = kind === "quick" ? "finding a room…" : "making a room…";
      const r = await getCode(kind, game);
      if (r.ok) return go(r.code);
      msg.textContent = r.error;
      buttons.forEach((b) => (b.disabled = false));
    }
    root.querySelector("[data-quick]")!.addEventListener("click", () => ask("quick"));
    root.querySelector("[data-new]")!.addEventListener("click", () => ask("new"));
    const input = root.querySelector<HTMLInputElement>("[data-code]")!;
    input.addEventListener("input", () => (input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, "")));
    root.querySelector("[data-join]")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const code = input.value.trim().toUpperCase();
      if (isCode(code)) go(code);
      else msg.textContent = "codes are 4 letters and numbers, like K7QX.";
    });
  }
</script>

<style>
  .start {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
  }
  .soon {
    color: var(--dim-1);
    border-left: 1px solid var(--acid);
    padding-left: 0.85rem;
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .join {
    display: grid;
    gap: 0.5rem;
  }
  .join-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) auto;
    justify-content: start;
    gap: 0.5rem;
  }
  .code {
    text-transform: uppercase;
    letter-spacing: var(--track-label);
  }
  .msg {
    min-height: 1.6em;
    color: var(--dim-1);
  }
  .explain {
    margin-top: var(--section);
    display: grid;
    gap: 1.5rem;
  }
  .h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    letter-spacing: var(--track-tight);
    line-height: 1;
    color: var(--bone);
  }
  .steps {
    list-style: decimal-leading-zero;
    padding-left: 2.5em;
    display: grid;
    gap: 0.6rem;
    max-width: 60ch;
  }
  .steps ::marker {
    color: var(--dim-2);
  }
  .explain :global(.faq-h) {
    margin-top: 2rem;
  }
</style>
