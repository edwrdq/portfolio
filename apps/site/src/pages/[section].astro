---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Entry from "../components/Entry.astro";
import Timeline from "../components/Timeline.astro";
import Label from "@edwrdq/ui/Label.astro";
import Row from "@edwrdq/ui/Row.astro";
import type { IconName } from "@edwrdq/ui/icons";
import { getIndex, pad } from "../lib/content";

export const getStaticPaths = (async () => {
  const index = await getIndex();
  const projects = await getCollection("projects");
  return index
    .map((s, i) => ({ s, n: pad(i + 1) }))
    .filter(({ s }) => s.id !== "blog")
    .map(({ s, n }) => ({
      params: { section: s.id },
      props: {
        section: s,
        n,
        entries: projects
          .filter((p) => p.data.section === s.id)
          .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      },
    }));
}) satisfies GetStaticPaths;

interface Props {
  section: CollectionEntry<"index">;
  n: string;
  entries: CollectionEntry<"projects">[];
}

const { section, n, entries } = Astro.props;
const { title, desc, intro, outro, note, layout, groups } = section.data;
const isTimeline = section.id === "work";

// no groups → one unnamed block. groups → one block each, in yml order;
// entries without a matching group land in a trailing "other" block.
type Block = { id?: string; n?: string; title?: string; intro?: string; entries: CollectionEntry<"projects">[] };
const blocks: Block[] = groups?.length
  ? [
      ...groups.map((g, i) => ({
        ...g,
        n: `${n}.${i + 1}`,
        entries: entries.filter((e) => e.data.group === g.id),
      })),
      ...(() => {
        const rest = entries.filter((e) => !groups.some((g) => g.id === e.data.group));
        return rest.length ? [{ id: "other", n: `${n}.${groups.length + 1}`, title: "other", entries: rest }] : [];
      })(),
    ]
  : [{ entries }];
---

<Base title={title} description={intro ?? desc} og={section.id}>
  <PageHead n={n} label={desc.toUpperCase()} title={title} intro={intro} />

  {
    note && (
      <aside class="note gutter" aria-label="note">
        <div class="note-inner">
          <p class="note-text">{note.text}</p>
          <figure class="note-fig">
            <img src={note.image} alt={note.alt} loading="lazy" decoding="async" />
            {(note.caption || note.captionLink) && (
              <figcaption>
                {note.caption}
                {note.captionLink && (
                  <>
                    {" "}
                    <a href={note.captionLink.href} target="_blank" rel="noopener">
                      {note.captionLink.label} <span aria-hidden="true">↗</span>
                    </a>
                  </>
                )}
              </figcaption>
            )}
          </figure>
        </div>
      </aside>
    )
  }

  {
    blocks.map((b) => (
      <section class="list gutter" id={b.id} aria-label={b.title}>
        {b.title && (
          <header class="group">
            <Label n={b.n}>{b.title.toUpperCase()}</Label>
            <h2 class="display group-title">{b.title}</h2>
            {b.intro && <p class="group-intro">{b.intro}</p>}
          </header>
        )}
        {b.entries.length === 0 ? (
          layout !== "rows" && <p class="empty">nothing here yet<span class="cursor">_</span></p>
        ) : layout === "rows" ? (
          <ol class="rows">
            {b.entries.map((e, i) => (
              <Row
                n={i + 1}
                title={e.data.title}
                desc={e.data.summary}
                icon={e.data.icon as IconName | undefined}
                href={e.data.href}
                status={e.data.status}
              />
            ))}
          </ol>
        ) : isTimeline ? (
          <Timeline entries={b.entries} />
        ) : (
          <div class="entries">
            {b.entries.map((e, i) => (
              <Entry entry={e} n={pad(i + 1)} />
            ))}
          </div>
        )}
      </section>
    ))
  }

  {outro && (
    <div class="gutter">
      <p class="outro">{outro}</p>
    </div>
  )}

  <nav class="back gutter label" aria-label="back">
    <a href="/">← INDEX</a>
  </nav>
</Base>

<style>
  .list + .list {
    margin-top: var(--section);
  }
  .group {
    padding-bottom: 2rem;
  }
  .group-title {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    font-weight: 600;
    line-height: 0.9;
    text-transform: lowercase;
  }
  .group-intro {
    margin-top: 1.25rem;
    margin-left: var(--offset);
    color: var(--dim-1);
    max-width: 36ch;
  }
  .entries {
    border-bottom: 1px solid var(--seam-soft);
  }
  .rows {
    border-bottom: 1px solid var(--seam-soft);
  }

  .note {
    margin-bottom: 4rem;
  }
  .note-inner {
    display: grid;
    gap: 2rem;
  }
  .note-text {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--dim-1);
    max-width: 60ch;
  }
  .note-fig {
    width: 100%;
    max-width: 320px;
  }
  .note-fig img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    border-radius: 0;
  }
  .note-fig figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim-2);
  }
  .note-fig a {
    border-bottom: 1px solid var(--dim-4);
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }
  .note-fig a:hover {
    color: var(--bone);
    border-color: var(--bone);
  }
  @media (min-width: 960px) {
    .note-inner {
      margin-left: var(--offset);
      grid-template-columns: minmax(0, 1fr) 240px;
      gap: 2.5rem;
      align-items: start;
    }
    .note-fig {
      max-width: 240px;
    }
  }
  .empty {
    margin-left: var(--offset);
    color: var(--dim-2);
    padding-block: 2rem;
    border-top: 1px solid var(--seam-soft);
  }
  .outro {
    margin-top: 3rem;
    margin-left: var(--offset);
    max-width: 52ch;
    color: var(--dim-1);
  }
  .back {
    margin-top: 4rem;
  }
  .back a {
    color: var(--dim-1);
    transition: color var(--fast) var(--ease);
  }
  .back a:hover {
    color: var(--bone);
  }
</style>
